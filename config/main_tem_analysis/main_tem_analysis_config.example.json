      "entry_dir": "../../data/tem_analysis/2024-08-19_low_agglomeration",
      "aggregate": {
        "file": "atems_aggregate_metrics/19AUG24_LAL_End_Slider.mat",
        "variable": "Aggs"
      },
      "primary_particles": {
        "folder": "imagej_primary_particle_metrics",
        "file_pattern": "PFA_ET+NIT_LAL_19AUG24_End_%d.csv",
        "area_column": "Area"
      },
      "aggregate_ids": {
        "start": 1,
        "end": 64
      },
      "plot": {
        "marker": "^"
      },
      "include_in_model_inputs": true,
      "include_in_publication_plots": true,
      "include_in_hybridity_scatter": true
    },
    {
      "id": "2025_02_06_high_agglomeration",
