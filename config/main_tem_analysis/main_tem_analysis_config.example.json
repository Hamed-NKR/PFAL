{
  "analysis": {
    "coverage_threshold": 1.1,
    "logistic_bandwidth": 0.05,
    "primary_area_start_row": 2,
    "random_resample_count": 5000,
    "random_seed": 1
  },
  "outputs": {
    "data_root": "../../data/main_tem_analysis",
    "results_root": "../../results/main_tem_analysis",
    "mat_file": "tem_analysis_results.mat",
    "model_inputs_csv": "model_inputs.csv",
    "summary_csv": "summary_table.csv"
  },
  "plots": {
    "enabled": true,
    "visible": "on",
    "export": true,
    "format": "png",
    "resolution": 300,
    "save_figures": false,
    "axis_overrides": {}
  },
  "entries": [
    {
      "id": "2024_08_19_low_agglomeration",
      "label": "Low agglomeration",
